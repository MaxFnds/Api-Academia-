<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <header class="topo">
    <h1 class="logo">
      <a href="/dashboard" class="logo-link">FitWeb</a>
    </h1>
    <nav class="menu">
      <button id="botao-logout" class="botao botao--secundario">Sair</button>
    </nav>
  </header>

  <main class="container container--formulario">
    <a href="/dashboard" class="link-voltar">&larr; Voltar ao dashboard</a>

    <h2>Editar aluno</h2>
    <p class="subtitulo">Atualize os dados do aluno.</p>

    <form id="form-editar-aluno" class="form" data-aluno-id="<%= alunoId %>">
      <div class="campo">
        <label for="nome">Nome completo</label>
        <input type="text" id="nome" name="nome" required minlength="3">
      </div>

      <div class="campo">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email">
      </div>

      <div class="campo">
        <label for="idade">Idade</label>
        <input type="number" id="idade" name="idade" min="10" max="120">
      </div>

      <p class="mensagem-erro" id="mensagem-erro" hidden></p>
      <p class="mensagem-sucesso" id="mensagem-sucesso" hidden></p>

      <div class="acoes-formulario">
        <button type="submit" class="botao botao--primario">
          <span class="texto-botao">Salvar alterações</span>
          <span class="spinner" hidden></span>
        </button>
        <a href="/dashboard" class="botao botao--secundario">Cancelar</a>
      </div>
    </form>
  </main>

  <%- include('partials/rodape') %>
</body>
</html>


