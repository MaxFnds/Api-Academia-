<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <header class="topo">
    <h1 class="logo">FitWeb</h1>
    <nav class="menu">
      <span class="saudacao">Olá, <%= nome %> <span class="etiqueta-tipo"><%= tipo %></span></span>
      <button id="botao-logout" class="botao botao--secundario">Sair</button>
    </nav>
  </header>

  <main class="container">
    <div class="cabecalho-secao">
      <h2>Meus treinos</h2>
      <div class="acoes-cabecalho">
        <input
          type="search"
          id="busca-treino"
          class="campo-busca"
          placeholder="Buscar treino pelo nome..."
        >
          <% if (tipo === "instrutor") { %>
          <a href="/exercicios" class="botao botao--secundario">Exercícios</a>
          <a href="/exercicios/novo" class="botao botao--secundario">+ Novo exercício</a>
          <a href="/treinos/novo" class="botao botao--primario">+ Novo treino</a>
        <% } %>

      </div>
    </div>

    <p id="mensagem-carregando" class="mensagem-status">Carregando treinos...</p>
    <p id="mensagem-vazio" class="mensagem-status" hidden>Nenhum treino encontrado.</p>

    <ul id="lista-treinos" class="lista-treinos"></ul>
  </main>

  <%- include('partials/rodape') %>
</body>
</html>