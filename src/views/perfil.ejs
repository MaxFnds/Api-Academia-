<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <header class="topo">
    <h1 class="logo">
      <a href="/dashboard" class="logo-link">FitWeb</a>
    </h1>
    <nav class="menu">
      <button id="botao-logout" class="botao botao--secundario">Sair</button>
    </nav>
  </header>

  <main class="container container--formulario">
    <a href="/dashboard" class="link-voltar">&larr; Voltar ao dashboard</a>

    <h2>Meu perfil</h2>
    <p class="subtitulo">Atualize seus dados e foto de perfil.</p>

    <form id="form-perfil" class="form" data-usuario-id="<%= usuarioId %>">
      <!-- Foto de perfil -->
      <div class="campo">
        <label>Foto de perfil</label>
        <% if (fotoPerfil) { %>
          <div class="preview-foto">
            <img src="/<%= fotoPerfil %>" alt="Foto de perfil" class="foto-perfil-preview" onerror="this.hidden=true">
          </div>
        <% } %>
        <input type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/webp">
        <small class="dica-campo">Formatos aceitos: JPG, PNG ou WEBP. Máximo 5MB.</small>
      </div>

      <!-- Nome -->
      <div class="campo">
        <label for="nome">Nome completo</label>
        <input type="text" id="nome" name="nome" required minlength="3" value="<%= nome %>">
      </div>

      <!-- Email -->
      <div class="campo">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" value="<%= email %>">
      </div>

      <!-- Idade (apenas para alunos) -->
      <% if (tipo === "aluno") { %>
      <div class="campo">
        <label for="idade">Idade</label>
        <input type="number" id="idade" name="idade" min="10" max="120" value="<%= idade || '' %>">
      </div>
      <% } %>

      <!-- Especialidade (apenas para instrutores) -->
      <% if (tipo === "instrutor") { %>
      <div class="campo">
        <label for="especialidade">Especialidade</label>
        <input type="text" id="especialidade" name="especialidade" placeholder="Ex: CrossFit, Musculação..." value="<%= especialidade || '' %>">
      </div>
      <% } %>

      <p class="mensagem-erro" id="mensagem-erro" hidden></p>
      <p class="mensagem-sucesso" id="mensagem-sucesso" hidden></p>

      <div class="acoes-formulario">
        <button type="submit" class="botao botao--primario">
          <span class="texto-botao">Salvar alterações</span>
          <span class="spinner" hidden></span>
        </button>
      </div>
    </form>
  </main>

  <%- include('partials/rodape') %>
</body>
</html>


